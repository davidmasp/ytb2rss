{
  "name": "ytb2rss",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Convert YouTube channel IDs, handles, and URLs into feed URLs or OPML without an API key.",
  "exports": "./src/index.ts",
  "bin": {
    "ytb2rss": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --compile --minify --outfile ./dist/ytb2rss",
    "convert": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "entities": "^8.1.0"
  }
}
